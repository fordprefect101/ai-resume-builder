PORT=8081
DATABASE_URL=postgresql://resume:resume@localhost:5432/resume_builder
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false

# Required for every AI feature (chat, voice, enrichment, PDF import).
OPENAI_API_KEY=

# Optional: these are the defaults the code uses when unset.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ENRICH_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# Leave unset for now. The API does not send email yet (verify/reset links are
# printed to the server log); setting either only hides the dev link in responses.
# SMTP_HOST=
# RESEND_API_KEY=
