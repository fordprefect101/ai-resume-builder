PORT=8081
DATABASE_URL=postgresql://resume:resume@localhost:5432/resume_builder
PUBLIC_APP_URL=http://localhost:5173
COOKIE_SECURE=false

# Required for every AI feature (chat, voice, enrichment, PDF import).
OPENAI_API_KEY=

# Optional: these are the defaults the code uses when unset.
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_ENRICH_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini

# The writing team (api/writing/models.py). One line per job: provider:model.
# Leave unset to use OPENAI_CHAT_MODEL for every job.
# ANALYST_MODEL=openai:gpt-4.1-mini
# WRITER_MODEL=openai:gpt-4.1-mini
# CHECKER_MODEL=openai:gpt-4.1-mini

# Leave unset for now. The API does not send email yet (verify/reset links are
# printed to the server log); setting either only hides the dev link in responses.
# SMTP_HOST=
# RESEND_API_KEY=

# Daily AI limits per visitor (logged-in user, else session). They reset at UTC midnight.
# Over the limit a visitor gets a 429 and can bring their own key. Defaults shown.
DAILY_LIMIT_CHAT=30
DAILY_LIMIT_MUTATE=30
DAILY_LIMIT_REALTIME=5
DAILY_LIMIT_REWRITE=20
DAILY_LIMIT_ANALYZE_JD=5
DAILY_LIMIT_PDF_IMPORT=3
DAILY_LIMIT_ENRICHMENT=30

# Visitors can bring their own key (header X-OpenAI-Key, per request only). It is never stored or logged
# and those requests are not counted against the DAILY_LIMIT_* settings. Nothing to set here.
